{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ehm.dev/schema/1.0.0/ehm.ir.schema.json",
  "title": "EHM IR 1.0.0",
  "description": "可移植的代码结构图中间表示 —— 唯一的跨 Agent / 跨宿主模型层契约。只描述实体、关系、证据、视图查询参数与折叠参数。不描述坐标、尺寸、颜色、字体或任何宿主 API。宿主差异只能写入 x-<host> 扩展对象，或留在宿主侧的跳转模板配置里。",
  "type": "object",
  "required": ["schemaVersion", "meta", "entities", "relations", "views"],
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9]+(-[a-z0-9]+)*$": {
      "type": "object",
      "description": "宿主私有扩展命名空间。消费方必须忽略所有不认识的 x-*；x-* 永远不得成为任何必填语义的来源。"
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "IR 版本，完整语义化版本 MAJOR.MINOR.PATCH。版本策略见 EHM-IR.md §8。"
    },
    "meta": { "$ref": "#/definitions/meta" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "description": "实体池（去重、只存一份）。视图不复制实体，只通过 query/fold 引用它。",
      "items": { "$ref": "#/definitions/entity" }
    },
    "relations": {
      "type": "array",
      "description": "关系池（去重、只存一份）。视图通过 view.edge 只选其中一种 kind。",
      "items": { "$ref": "#/definitions/relation" }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "description": "视图 = 查询 + 折叠参数，不是四份数据。宿主一次只渲染其中一个时，其余视图的代价只是几百字节参数。",
      "items": { "$ref": "#/definitions/view" }
    },
    "diff": { "$ref": "#/definitions/diffContext" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/definitions/diagnostic" }
    }
  },
  "definitions": {
    "ident": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.$:@/-]*$",
      "description": "稳定标识。禁止用数组下标或随机数。同一容器内同名重载用 @参数摘要 或 @line 消歧。"
    },
    "snippetRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "description": "证据引用 id。viewer 在需要展示代码时用 ehm.hoverEvidence 向宿主按需取回，避免把代码塞进 IR。"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$",
      "description": "工作区相对路径，POSIX 分隔符，无前导 /，无反斜杠，不含 .. 段。绝对路径只在宿主侧生成，IR 内不出现。"
    },
    "position": {
      "type": "object",
      "required": ["file", "line"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "properties": {
        "file": { "$ref": "#/definitions/path" },
        "line": { "type": "integer", "minimum": 1, "description": "1-based 行号。LSP 的 0-based 由生成方转换后写入。" },
        "column": { "type": "integer", "minimum": 1, "description": "1-based 列号；缺省视为 1。" },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 256 },
        "basis": {
          "type": "string",
          "enum": ["definition", "usage", "anchor"],
          "description": "该位置的性质：definition=声明处；usage=使用处（外部能力在本工作区没有定义）；anchor=墓碑在现存代码中的落点。"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["file", "line"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "anyOf": [
        { "required": ["code"] },
        { "required": ["snippetRef"] }
      ],
      "description": "证据。file+line 永远必填（这是能跳转的最小充分条件）；代码本身 inline（code）或按需取（snippetRef）二选一，由 meta.evidenceMode 决定。",
      "properties": {
        "file": { "$ref": "#/definitions/path" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "逐字来自源码的片段（不改写、不格式化）。多行用 \\n 连接，行数必须等于 endLine-line+1。inline 模式下必填。"
        },
        "snippetRef": { "$ref": "#/definitions/snippetRef" },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["entity"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "description": "唯一地址空间：{entity} 或 {entity, member}。节点寻址、关系端点、协议消息里的 target 全部用它。用具名对象而不是裸字符串的收益：① 方法级端点是一等需求 —— member 与 entity 同层，schema 能直接表达「这条边的这一端是哪个方法」；② 未来加 memberKind / overload 时不动已有字段；③ 解析器可以按字段名报错（'member 不存在' 而不是 '字符串没匹配上'），错误信息能直接给人看。",
      "properties": {
        "entity": { "$ref": "#/definitions/ident" },
        "member": {
          "$ref": "#/definitions/ident",
          "description": "成员 id（不是 name）。必须是该实体 methods[].id 中的值 —— 用 id 而非 name，因为同名重载的 name 不唯一。有 member 才能落到方法级精度：点节点跳方法定义、点调用点跳调用处、点边跳被调方法。省略 member = 实体级端点（只能跳到实体定义）。"
        }
      }
    },
    "entityKind": {
      "type": "string",
      "enum": ["module", "file", "class", "interface", "function", "type", "const", "capability", "aggregate", "unknown"],
      "description": "实体种类。capability=工作区外、由运行环境注入的能力对象（通用架构词汇，不对应任何单一宿主的服务注册机制）。aggregate=折叠聚合节点。成员（字段/方法）不是实体，见 entity.fields/methods。"
    },
    "entityScope": {
      "type": "string",
      "enum": ["dir", "file", "symbol", "external"],
      "description": "聚合层级：dir=目录聚合，file=文件，symbol=符号，external=工作区外/无定义。下钻就是 view.query.filter.scopes 的取值变化。"
    },
    "visibility": { "type": "string", "enum": ["+", "-", "#", "~"] },
    "sizeTier": {
      "type": "string",
      "enum": ["L", "M", "S"],
      "description": "语义强调档位（主要/普通/叶子）。像素尺寸属于 layout 层，IR 内不出现任何 px。"
    },
    "entity": {
      "type": "object",
      "required": ["id", "kind", "name", "scope", "location"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "properties": {
        "id": { "$ref": "#/definitions/ident" },
        "kind": { "$ref": "#/definitions/entityKind" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256, "description": "展示名（最后一段）。不含宿主路径前缀。" },
        "qualifiedName": { "type": "string", "minLength": 1, "maxLength": 512, "description": "语言内的限定名，用于展示与匹配。" },
        "scope": { "$ref": "#/definitions/entityScope" },
        "parent": { "$ref": "#/definitions/ident", "description": "所属实体（目录含文件、文件含符号）。层级事实，不画边、不参与边预算。" },
        "location": { "$ref": "#/definitions/position" },
        "stereotype": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "构造型短标记，小写 kebab。推荐值见 §2.2；必须是宿主中立的角色词。"
        },
        "summary": { "type": "string", "maxLength": 200, "description": "一句话说明它是什么。语言由 meta.locale 决定。" },
        "size": { "$ref": "#/definitions/sizeTier" },
        "heat": { "type": "number", "minimum": 0, "maximum": 1, "description": "热点强度。只表达状态（渲染为强调/透明度），不表达类型。" },
        "entry": { "type": "boolean", "description": "是否为该视图的入口/根候选。" },
        "folded": { "$ref": "#/definitions/folded" },
        "diff": { "$ref": "#/definitions/diffEntity" },
        "fields": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/field" } },
        "methods": { "type": "array", "maxItems": 500, "items": { "$ref": "#/definitions/method" } },
        "evidence": { "$ref": "#/definitions/evidence" }
      }
    },
    "folded": {
      "type": "object",
      "required": ["count"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 100000, "description": "被折叠掉的节点数。标签由 fold.aggregateLabel 代入，如 +3 more。" },
        "members": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/definitions/ident" },
          "description": "被折叠清单。折叠永远可见（P3）：清单可进侧栏，禁止静默截断。"
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "maxLength": 512 },
        "visibility": { "$ref": "#/definitions/visibility" },
        "summary": { "type": "string", "maxLength": 200 },
        "location": { "$ref": "#/definitions/position" },
        "evidence": { "$ref": "#/definitions/evidence" }
      }
    },
    "method": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "properties": {
        "id": { "$ref": "#/definitions/ident", "description": "容器内稳定的成员 id；关系端点与协议 target 的 member 引用它。" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "visibility": { "$ref": "#/definitions/visibility" },
        "params": { "type": "string", "maxLength": 1024 },
        "returns": { "type": "string", "maxLength": 512 },
        "signature": { "type": "string", "maxLength": 1024, "description": "第二行完整签名；缺省由 params/returns 拼装。" },
        "abstract": { "type": "boolean" },
        "static": { "type": "boolean" },
        "summary": { "type": "string", "maxLength": 200 },
        "location": { "$ref": "#/definitions/position" },
        "evidence": { "$ref": "#/definitions/evidence" }
      }
    },
    "relationKind": {
      "type": "string",
      "enum": ["calls", "imports", "extends", "implements", "uses", "contains", "diff-change"],
      "description": "边类型。P1：一个视图只能选其中一种（view.edge.kind 是标量，不是数组）。contains 是层级事实，可以存在但永不绘制。"
    },
    "provenance": {
      "type": "string",
      "enum": ["lsp", "ast", "heuristic"],
      "description": "这条关系怎么得到的：lsp=语言服务器解析；ast=语法树静态解析；heuristic=启发式猜测（如按名字匹配）。"
    },
    "site": {
      "type": "object",
      "required": ["file", "line"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "properties": {
        "file": { "$ref": "#/definitions/path" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "code": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "snippetRef": { "$ref": "#/definitions/snippetRef" },
        "form": {
          "type": "string",
          "enum": ["direct", "method", "ctor", "reexport", "dynamic"],
          "description": "调用形式。dynamic=目标无法静态确认（FR-1.10 的 unknown-call）。"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "kind", "from", "to", "evidence", "provenance", "confidence"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "properties": {
        "id": { "$ref": "#/definitions/ident" },
        "kind": { "$ref": "#/definitions/relationKind" },
        "from": { "$ref": "#/definitions/endpoint" },
        "to": { "$ref": "#/definitions/endpoint" },
        "label": { "type": "string", "maxLength": 80, "description": "边的动作目的（不是「调用了」三个字）。渲染在线上或 hover 里。" },
        "evidence": { "$ref": "#/definitions/evidence", "description": "促成这条关系的最主要一行/一段源码。悬停显示、跳转依据。没有证据的关系不得进入 IR。" },
        "provenance": { "$ref": "#/definitions/provenance" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "0-1。决定跳转可信度与边样式：<0.8 视为弱证据，渲染虚线且点击先给候选。" },
        "sites": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/definitions/site" },
          "description": "同一对端点的全部调用点/引用点。×N 徽标计数 = sites.length（缺省按 1 计）。"
        },
        "external": { "type": "boolean", "description": "目标在工作区外。" },
        "cycle": { "type": "boolean", "description": "成环。" },
        "role": {
          "type": "string",
          "enum": ["affected", "context"],
          "description": "仅 diff-change 使用：affected=变更节点之间；context=未变更但被牵连的上下文（渲染为低透明度）。这不是第二种边类型。"
        }
      }
    },
    "viewType": {
      "type": "string",
      "enum": ["map", "flow", "impact", "diff", "uml"],
      "description": "视图类型。类型只决定语义（问什么问题），不决定边种类；边种类由 view.edge 显式声明并被 P1 校验。"
    },
    "viewEdge": {
      "type": "object",
      "required": ["kind", "direction"],
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/definitions/relationKind" },
        "direction": { "type": "string", "enum": ["forward", "reverse"], "description": "reverse=反向渲染（Impact 图：被调方在左）。不产生新数据。" }
      }
    },
    "viewFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entityKinds": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/entityKind" } },
        "scopes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/entityScope" } },
        "diffKinds": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["added", "removed", "modified", "signature"] } },
        "excludeTests": { "type": "boolean" }
      }
    },
    "viewFold": {
      "type": "object",
      "required": ["maxNodes", "maxEdges", "mechanism"],
      "additionalProperties": false,
      "properties": {
        "maxNodes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "maxEdges": { "type": "integer", "minimum": 0, "maximum": 120 },
        "mechanism": { "type": "string", "enum": ["aggregate", "none"], "description": "aggregate=超限生成 +N more 聚合节点；none=超限直接报错（空态），仅用于明确不折叠的场景。" },
        "aggregationOrder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "enum": ["directory", "degree", "depth"] },
          "description": "折叠顺序，依次尝试直到进入预算（GRAPH-SPEC 5.2）。"
        },
        "aggregateLabel": { "type": "string", "minLength": 2, "maxLength": 24, "pattern": "\\{n\\}", "description": "聚合节点标签模板，必须含 {n}。" }
      }
    },
    "viewFoldResult": {
      "type": "object",
      "required": ["nodes", "edges", "collapsed", "hitBudget"],
      "additionalProperties": false,
      "description": "【数据，不是查询参数】生成方折叠后实际会渲染出的计数。它必须进 IR：因为消费方拿到的只有被折叠过的实体池，自己重算不出「原本有多少、折叠掉了几个」。validate.mjs 用它与按 query 解析出的结果交叉核对（R6），任何不一致都是 error。",
      "properties": {
        "nodes": { "type": "integer", "minimum": 0, "maximum": 100000, "description": "折叠后渲染出的节点数（已含 +N more 聚合节点）。" },
        "edges": { "type": "integer", "minimum": 0, "maximum": 100000, "description": "折叠后渲染出的边数。" },
        "collapsed": { "type": "integer", "minimum": 0, "maximum": 100000, "description": "被折叠进聚合节点的原始节点数。>0 时必须存在 kind=aggregate 的实体承载。" },
        "hitBudget": { "type": "boolean", "description": "是否因触达预算而折叠。true 且 collapsed=0 = 静默截断，validate 报 error。" }
      }
    },
    "view": {
      "type": "object",
      "required": ["id", "type", "edge", "query", "fold"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "properties": {
        "id": { "$ref": "#/definitions/ident" },
        "type": { "$ref": "#/definitions/viewType" },
        "title": { "type": "string", "maxLength": 80 },
        "facet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "同一视图类型下的「面」。uml 视图必填：calls=调用面（方法级端口）/ types=类型面（继承与实现）。"
        },
        "edge": { "$ref": "#/definitions/viewEdge" },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
          },
          "properties": {
            "root": { "$ref": "#/definitions/endpoint", "description": "图的根/入口。下钻与展开都由它变化表达。" },
            "depth": { "type": "integer", "minimum": 1, "maximum": 8 },
            "filter": { "$ref": "#/definitions/viewFilter" }
          }
        },
        "fold": { "$ref": "#/definitions/viewFold" },
        "layoutFamily": {
          "type": "string",
          "enum": ["columns", "layered", "uml", "auto"],
          "description": "布局族（抽象名，不是算法）。layout 层把族映射到具体实现：columns→列分组，layered→dagre/ELK，uml→类图分层。IR 不指定算法与参数。"
        },
        "foldResult": { "$ref": "#/definitions/viewFoldResult" }
      }
    },
    "diffContext": {
      "type": "object",
      "required": ["base", "head", "source"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "properties": {
        "base": { "type": "object", "required": ["ref"], "additionalProperties": false, "properties": { "ref": { "type": "string", "minLength": 1, "maxLength": 200 } } },
        "head": { "type": "object", "required": ["ref"], "additionalProperties": false, "properties": { "ref": { "type": "string", "minLength": 1, "maxLength": 200 } } },
        "source": { "type": "string", "enum": ["patch", "git-refs", "worktree"] }
      }
    },
    "diffEntity": {
      "type": "object",
      "required": ["kind", "anchor"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "properties": {
        "kind": { "type": "string", "enum": ["added", "removed", "modified", "signature"], "description": "diffKind 枚举。只有这四类。" },
        "anchor": {
          "type": "object",
          "required": ["file", "line", "basis"],
          "additionalProperties": false,
          "properties": {
            "file": { "$ref": "#/definitions/path" },
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 },
            "basis": {
              "type": "string",
              "enum": ["definition", "first-hunk", "signature", "hunk-anchor", "file-start", "none"],
              "description": "锚点性质，决定「能不能跳、跳到哪」：definition=新定义行；first-hunk=该符号第一个变更 hunk；signature=签名行；hunk-anchor=墓碑在旧位置对应处的新代码落点；file-start=退化到新文件第 1 行；none=不可跳。"
            }
          }
        },
        "origin": { "$ref": "#/definitions/position", "description": "旧版本位置。只用于展示「原来在哪」，永远不得作为跳转目标（G5：diff 只跳当前代码）。" },
        "originalSignature": { "type": "string", "maxLength": 1024 },
        "renamedFrom": { "$ref": "#/definitions/path", "description": "重命名来源路径（git diff -M 探测到 rename 时）。该节点按 modified 处理，跳新路径。" },
        "fileDeleted": { "type": "boolean", "description": "整个文件被删除。此时 anchor.basis 必须是 none，节点不可跳，只提供「复制原路径」。" },
        "addedLines": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "removedLines": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "meta": {
      "type": "object",
      "required": ["locale", "generatedAt", "generator", "workspace", "evidenceMode"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
      },
      "properties": {
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "generatedAt": { "type": "string", "format": "date-time", "maxLength": 40 },
        "generator": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "patternProperties": {
            "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
          },
          "description": "谁产出了这份 IR。capabilities 是**生成方**的自述（它实际用上了哪些分析能力），不是宿主的、也不是可信度评分；每条关系的可信度只由 relation.provenance + relation.confidence 表达。",
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "version": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][A-Za-z0-9.-]+)*$" },
            "mode": { "type": "string", "enum": ["static", "lsp-assisted", "manual"] },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "description": "生成方自述的分析能力开关。仅供诊断与解释「为什么有些关系是 heuristic」，禁止消费方用它推断某条关系的可信度——以该关系的 provenance/confidence 为准。",
              "properties": {
                "lsp": { "type": "boolean" },
                "git": { "type": "boolean" }
              }
            }
          }
        },
        "workspace": {
          "type": "object",
          "required": ["root"],
          "additionalProperties": false,
          "patternProperties": {
            "^x-[a-z0-9]+(-[a-z0-9]+)*$": { "type": "object" }
          },
          "properties": {
            "root": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "不透明的工作区名。IR 内所有 file 都相对它；把它解析成本机绝对路径是宿主的事。" },
            "vcs": {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "type": "string", "enum": ["git", "none"] },
                "base": { "type": "string", "maxLength": 200 },
                "head": { "type": "string", "maxLength": 200 }
              }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "deprecated": true,
          "description": "已废弃的 v1.0.0 早期位置。请写到 meta.generator.capabilities。为兼容早期生成方保留读取，写入方不应再产出。",
          "properties": {
            "lsp": { "type": "boolean" },
            "git": { "type": "boolean" }
          }
        },
        "evidenceMode": {
          "type": "string",
          "enum": ["inline", "deferred", "slim"],
          "description": "evidenceMode 决定证据代码怎么到达消费方。数据字段仍统一用 evidence.code（inline）与 evidence.snippetRef（deferred/slim），不是三个平行 schema。",
          "$comment": "inline=代码内联；deferred=只给 file/line/snippetRef，悬停时按需取；slim=同 deferred 且额外要求 code 必须缺失（validate 会 warn 名不副实）。"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": { "type": "string", "enum": ["info", "warn", "error"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "file": { "$ref": "#/definitions/path" },
        "line": { "type": "integer", "minimum": 1 },
        "code": { "type": "string", "maxLength": 64 }
      }
    }
  }
}
